# Copy this file to .env and fill in your values: cp .env.example .env
# .env is git-ignored. Never commit real API keys.

# --- LLM -------------------------------------------------------------------
# CrewAI reads MODEL as the default LLM for every agent (format: provider/model-id).
MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key

# Other Claude models (same ANTHROPIC_API_KEY):
# MODEL=anthropic/claude-sonnet-5-5   # faster, cheaper
# MODEL=anthropic/claude-haiku-5-5    # cheapest, good for quick experiments

# Free local model with Ollama (https://ollama.com, run: ollama pull llama3.2):
# MODEL=ollama/llama3.2

# --- Tools (Phase 2) -------------------------------------------------------
# Web search for SerperDevTool (https://serper.dev):
# SERPER_API_KEY=your-serper-api-key

# --- Privacy (optional) ----------------------------------------------------
# CREWAI_DISABLE_TELEMETRY=true   # turn off CrewAI's anonymous usage telemetry
# CREWAI_TRACING_ENABLED=false    # never send execution traces to CrewAI AMP
